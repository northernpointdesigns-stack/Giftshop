{
  "name": "boutique-pos",
  "productName": "BoutiquePOS",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "build": "node -e \"console.log('Using pre-built web bundle from dist/')\"",
    "electron:build:mac": "electron-builder --mac",
    "electron:build:win": "electron-builder --win",
    "electron:build:linux": "electron-builder --linux",
    "electron:build:appimage": "electron-builder --linux AppImage",
    "electron:build:snap": "electron-builder --linux snap"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.boutiquepos.app",
    "productName": "BoutiquePOS",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "electron-main.js",
      "package.json",
      "dist/**/*"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Utility",
      "target": [
        "AppImage",
        "snap"
      ]
    },
    "snap": {
      "summary": "Point of sale application",
      "description": "BoutiquePOS is a point of sale application for retail boutiques.",
      "confinement": "strict",
      "grade": "stable",
      "plugs": [
        "default"
      ]
    }
  }
}