# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ---- Licensing / Distribution (desktop & CI builds) ----
# Set these as GitHub Actions Variables/Secrets on the Giftshop (customer) repo.
# The workflow writes them into .env.production before npm run build.
#
# VITE_PURCHASE_URL — Payhip checkout link on the activation screen.
# VITE_PAYHIP_PRODUCT_SECRET — Payhip per-product secret (License keys).
#   One build can verify keys from MULTIPLE Payhip products: supply a
#   comma-separated list, e.g. "prod_sk_AAA...,prod_sk_BBB..."
# VITE_DISABLE_LICENSE=1 — unlocked owner builds ONLY (Giftshopownervs).
#   Never set this on the customer Giftshop repo.
VITE_PURCHASE_URL="https://payhip.com/b/YOUR_PRODUCT"
# VITE_PAYHIP_PRODUCT_SECRET=""
# VITE_DISABLE_LICENSE=1
