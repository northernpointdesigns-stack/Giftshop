{
  "appId": "com.thegiftshop.pos",
  "productName": "The Gift Shop POS",
  "directories": {
    "output": "dist-desktop"
  },
  "files": [
    "dist/**/*",
    "electron-main.js",
    "package.json",
    "!node_modules/@esbuild/**",
    "!node_modules/@rollup/**",
    "!node_modules/@tailwindcss/**",
    "!node_modules/esbuild/**",
    "!node_modules/rollup/**",
    "!node_modules/tailwindcss/**",
    "!node_modules/lightningcss*/**",
    "!node_modules/fsevents/**",
    "!node_modules/vite/**",
    "!node_modules/@vitejs/**",
    "!node_modules/concurrently/**",
    "!node_modules/@tailwindcss/vite/**"
  ],
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": [
          "universal"
        ]
      }
    ],
    "category": "public.app-category.business",
    "darkModeSupport": true,
    "artifactName": "The Gift Shop POS-${version}-${arch}.${ext}"
  },
  "dmg": {
    "title": "The Gift Shop POS 1.0.0",
    "background": "build/dmg-background.png",
    "window": {
      "width": 660,
      "height": 400
    },
    "contents": [
      {
        "x": 180,
        "y": 190,
        "type": "file"
      },
      {
        "x": 480,
        "y": 190,
        "type": "link",
        "path": "/Applications"
      },
      {
        "x": 330,
        "y": 330,
        "type": "file",
        "name": "Install.command",
        "path": "build/Install.command"
      }
    ]
  },
  "extraResources": [
    {
      "from": "build/support",
      "to": "support",
      "filter": [
        "**/*"
      ]
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64",
          "ia32"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "The Gift Shop POS",
    "runAfterFinish": true
  }
}